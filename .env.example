# ==========================================
# Telegram Bot 告警通知配置
# ==========================================
# Telegram Bot Token (通过 @BotFather 申请获得)
TELEGRAM_BOT_TOKEN=
# 接收通知的 Chat ID (个人 Chat ID 或群组 ID，可通过 @userinfobot 获取)
TELEGRAM_CHAT_ID=
# 可选: HTTP/SOCKS5 代理地址 (大陆服务器/网络环境必备，如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080)
TELEGRAM_PROXY=

# 功能开关控制 (true / false，默认 false)
TELEGRAM_ALERT_ENABLED=false

# 监听交易所 (hyperliquid / bybit / all，默认 hyperliquid)
TELEGRAM_ALERT_EXCHANGE=hyperliquid

# 监听资产代码 (逗号分隔，默认 HYPER，自动兼容识别官方 HYPE)
TELEGRAM_ALERT_SYMBOLS=HYPER

# 是否参考基差触发告警 (true / false，默认 true)
# 注：基差是先行指标，较资金费率反应更早。若设为 true，当合约与现货基差超过阈值时触发建仓提醒
TELEGRAM_ALERT_CHECK_SPREAD=true

# 合约与现货基差阈值 (百分比，例如 0.10 表示基差率 >= +0.10% 触发)
TELEGRAM_ALERT_MIN_SPREAD_PCT=0.10

# 是否参考资金费率触发告警 (true / false，默认 true)
# 若设为 false，则仅参考基差；但在告警通知中依然会实时展示当前资金费率
TELEGRAM_ALERT_CHECK_FUNDING=true

# 资金费率年化 APR 阈值 (百分比，例如 20.0 表示年化费率 >= 20% 触发)
TELEGRAM_ALERT_MIN_APR_PCT=20.0

# 告警静默冷却时间 (分钟，默认 30 分钟内同一币种同一条件不重复告警，防止刷屏)
TELEGRAM_ALERT_COOLDOWN_MINUTES=30

# 后台轮询巡检间隔 (秒，默认 30)
TELEGRAM_ALERT_POLL_INTERVAL=30

# ==========================================
# 策略二: 毫秒级自动化抢基差建仓配置 (Auto-Arbitrage)
# ==========================================
# 自动化建仓总开关 (true / false，默认 false)
AUTO_ARBITRAGE_ENABLED=false

# 演练模拟模式 (true: 仅模拟测算不报单 / false: 实盘通过 API Wallet 真实下单)
AUTO_ARBITRAGE_DRY_RUN=true

# 自动化监控与建仓标的 (默认 HYPER，自动兼容 HYPE)
AUTO_ARBITRAGE_SYMBOLS=HYPER

# 触发建仓的基差阈值 (百分比，默认 0.08 表示合约较现货高出 >= +0.08% 时触发)
AUTO_ARBITRAGE_MIN_SPREAD_PCT=0.08

# 触发建仓的资金费率年化底线 (百分比，默认 10.0 表示 APR >= 10% 满足)
AUTO_ARBITRAGE_MIN_APR_PCT=10.0

# 资金利用策略 (Scheme D 资金管理体系):
# 1. 累计建仓最大本金上限 (USD，默认 5000，当前币种套利头寸总市值不超过此限额)
AUTO_ARBITRAGE_MAX_TOTAL_CAPITAL_USD=5000.0

# 2. 单笔建仓目标本金 (USD，默认 500，分批进场，降低盘口冲击与滑点)
AUTO_ARBITRAGE_PER_TRADE_USD=500.0

# 3. 账户现货现金保留底线 (USD，默认 1000，钱包中永远锁留至少此金额作为流动性与抗爆安全垫)
AUTO_ARBITRAGE_MIN_CASH_RESERVE_USD=1000.0

# 4. 最大允许吃单滑点 (百分比，默认 0.30 表示双边 IOC 限价在最好盘口上浮/下浮 0.30%)
AUTO_ARBITRAGE_MAX_SLIPPAGE_PCT=0.30

# 5. 单币种建仓冷却时间 (秒，默认 120 秒，避免单次波动期间连续重复报单)
AUTO_ARBITRAGE_COOLDOWN_SECONDS=120.0

# 6. 防瞬时虚假毛刺持续性滤波 (Persistence Filter):
# 连续达到阈值的 Tick 数 (默认 2，要求连续 2 个 Tick 保持在阈值以上，过滤 1ms 撤单毛刺)
AUTO_ARBITRAGE_PERSISTENCE_TICKS=2
# 达到阈值的最小持续毫秒数 (默认 100ms)
AUTO_ARBITRAGE_PERSISTENCE_MS=100.0

# 7. 稳健结构性基差审核算法 (Reliable Basis Auditor - 杜绝与做市商拼手速/拦截假毛刺):
# 强制要求稳健基差认证 (true: 仅在基差评分达到 Grade A 时才建仓 / false: 激进抢单模式)
AUTO_ARBITRAGE_REQUIRE_RELIABLE_BASIS=true
# 稳健评分达标底线 (0~100 分，默认 80.0 即 Grade A 稳健认证)
AUTO_ARBITRAGE_MIN_RELIABILITY_SCORE=80.0
# 滚动时间持续性审核窗口 (秒，默认 30.0 秒内平台不崩溃)
AUTO_ARBITRAGE_WINDOW_SECONDS=30.0
# 最差时刻 P10 分位数底线 (百分比，默认 0.02 表示 30s 内即使回撤也必须稳定在 >= +0.02%)
AUTO_ARBITRAGE_MIN_P10_FLOOR_PCT=0.02
# 盘口买方挂单吸收倍数 (默认 2.5，要求买方盘口深度 >= 2.5 倍单笔建仓金额，确保吃单不打穿)
AUTO_ARBITRAGE_MIN_DEPTH_MULTIPLE=2.5

# Telegram 告警过滤: 是否仅在确认稳健结构性基差时才推送通知 (true: 彻底静默假毛刺 / false: 全部推送并附带可靠性评分诊断)
TELEGRAM_ALERT_ONLY_RELIABLE=false


